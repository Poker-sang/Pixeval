<controls:EnhancedPage
    x:Class="Pixeval.Pages.PostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:local="using:Pixeval.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollView>
        <StackPanel Padding="100" Spacing="10">
            <Grid
                MaxWidth="800"
                MaxHeight="500"
                Tapped="LoadNewFileOnTapped">
                <Button
                    x:Name="UploadButton"
                    Height="200"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <fluent:SymbolIcon FontSize="50" Symbol="FolderArrowUp" />
                </Button>
                <Image x:Name="FileThumbnailImage" Stretch="Uniform" />
            </Grid>
            <TextBlock x:Name="PathTextBlock" HorizontalAlignment="Center" />
            <TextBox x:Name="TitleTextBox" Header="标题" />
            <TextBox x:Name="DescriptionTextBox" Header="描述" />
            <Button
                x:Name="PostButton"
                Width="200"
                Height="50"
                HorizontalAlignment="Center"
                Click="ButtonBase_OnClick"
                Content="{fluent:SymbolIcon Symbol=Send}"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ScrollView>
</controls:EnhancedPage>
